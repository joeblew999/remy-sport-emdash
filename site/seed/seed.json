							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k078",
									"text": "This project is for all basketball events in Thailand, not only school events: a page anyone can come to and find events. Registering to play through it is the aim, and it is not open yet.",
									"marks": []
								}
							]
