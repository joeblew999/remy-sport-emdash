		"posts": [
			{
				"id": "post-what-works-today",
				"slug": "what-works-today",
				"locale": "en",
				"status": "published",
				"data": {
					"title": "What works today, and what does not",
					"excerpt": "A plain list of what you can do in the app now, and what is still being built.",
					"angle": "An honest status report, so nobody arrives expecting registration to be open.",
					"content": [
						{
							"_type": "block",
							"_key": "k133",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k132",
									"text": "Basketball events in Thailand are spread across Facebook groups, LINE groups and Google Forms. This project puts them in one place and gives organisers a tool to run them. Here is where it stands.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k135",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k134",
									"text": "You can do this now",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k137",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k136",
									"text": "Sign in with a one-time code sent by email. There are no passwords.",
									"marks": []
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "k139",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k138",
									"text": "Browse and filter events, and open a page for each.",
									"marks": []
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "k141",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k140",
									"text": "Create and edit events, and share the work with co-organisers.",
									"marks": []
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "k143",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k142",
									"text": "Set up organisations, teams and divisions.",
									"marks": []
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "k145",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k144",
									"text": "Build fixtures, enter scores and set match status.",
									"marks": []
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "k147",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k146",
									"text": "Read result pages and standings without an account.",
									"marks": []
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "k149",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k148",
									"text": "Use Thai or English.",
									"marks": []
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "k151",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k150",
									"text": "Still being built",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k153",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k152",
									"text": "Registering a team for an event.",
									"marks": []
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
							"_type": "block",
							"_key": "k155",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k154",
									"text": "Managing a roster.",
									"marks": []
								}
							],
							"listItem": "bullet",
							"level": 1
						},
						{
