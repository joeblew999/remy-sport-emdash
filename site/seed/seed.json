									"_type": "span",
									"_key": "k156",
									"text": "Both exist in the app as things you can look at. Neither can be used yet.",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k159",
							"style": "h2",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k158",
									"text": "This website",
									"marks": []
								}
							]
						},
						{
							"_type": "block",
							"_key": "k161",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "k160",
									"text": "The app is built for people who are signed in. This website is for everyone else: it says what the project is, and it will list events so that a search engine, or a link shared in a chat, shows something useful.",
