{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "remy-sport-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// The site's own address (LIVE_URL in mise.toml). Cloudflare makes its DNS record and certificate.
	"routes": [{ "pattern": "www.remy.ubuntusoftware.net", "custom_domain": true }],
	// And no other. The cache in front of the Worker is keyed by path, not host, and robots.txt is not
	// the same on every host (src/pages/robots.txt.ts disallows everything on a host that is not the
	// public address): a crawler asking the workers.dev address would put that answer in the cache
	// for www as well. Previews keep their own addresses (preview_urls, below).
	"workers_dev": false,
	// Where this site sends people, and which app it reads. Read in src/lib/app.ts and nowhere
	// else. A local `.dev.vars` (gitignored) can set APP_API_ORIGIN to the app's staging twin.
	"vars": {
		"APP_ORIGIN": "https://remy.ubuntusoftware.net",
		"HELP_ORIGIN": "https://help.remy.ubuntusoftware.net",
		// "true" once the app this site reads holds real events. Until then event and organisation
		// pages carry a "sample data" notice and noindex, and stay out of the sitemap: the app's
		// test entries are invented events under real schools' names.
		"APP_DATA_IS_REAL": "false",
		// Cloudflare Access is in front of /_emdash (mise run signin:access made the application and
		// printed this). EmDash checks every admin and API request carries a pass made for it.
		"CF_ACCESS_AUDIENCE": "01936c6945e68b8c207c3cd509ef52c52799de4c7df33f98d91fd8d9ca0fec5a",
	},
	// No per-version preview addresses: they would be a second way in, with no Access in front.
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "remy-sport-site",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "remy-sport-site-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	"worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
	// A preview (mise run live:preview) gets none of the live site's bindings: these are its own.
	// Every preview of this site shares them. Written by emdash-run; yours to change.
	"previews": {
		"worker_loaders": [{"binding":"LOADER"}],
		"vars": {
			"APP_ORIGIN": "https://remy.ubuntusoftware.net",
			"HELP_ORIGIN": "https://help.remy.ubuntusoftware.net",
			"APP_DATA_IS_REAL": "false",
			"CF_ACCESS_AUDIENCE": "01936c6945e68b8c207c3cd509ef52c52799de4c7df33f98d91fd8d9ca0fec5a"
		},
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "remy-sport-site-preview",
				"database_id": "b0e195f6-6afe-4645-83c4-d938260b6a77"
			}
		],
		"r2_buckets": [
			{
				"binding": "MEDIA",
				"bucket_name": "remy-sport-site-preview-media"
			}
		],
		"kv_namespaces": [
			{
				"binding": "SESSION",
				"id": "182435ed0a714e8abb4aa18c321a9bfe"
			}
		]
	},
	// a deploy clears the page cache; the usage card finds this Worker (Coywolf Pack)
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	// cache warming and internal link checks call the Worker itself (Coywolf Pack)
	"services": [{ "binding": "SELF", "service": "remy-sport-site" }],
	// Smart Placement: the Worker runs near its database (Coywolf Pack)
	"placement": { "mode": "smart" },
	// Workers Logs: the usage card's estimate of what warming costs (Coywolf Pack)
	"observability": { "enabled": true },
}
