---
// The one layout. It does all the EmDash wiring — settings, menus, the SEO head — so a page only
// says what it is. The one thing a page must do itself is `loadShell(Astro)`: cache headers are
// fixed when a page's own frontmatter ends, before any layout runs. Nothing here names the brand: the name and tagline are EmDash site settings.
import { sanitizeHref } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { DEFAULT_LOCALE, directionOf, t, type Locale } from "../i18n/ui";
import { appHref, helpHref } from "../lib/app";
import { absoluteUrl, identity, localeOf, localePath, neutralPath, type Shell } from "../lib/site";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	/** Settings and menus, from `loadShell(Astro)` in the page's own frontmatter. */
	shell: Shell;
	/** The page's own title, without the site name. Omit on the home page. */
	title?: string | null;
	description?: string | null;
	/** Absolute or site-relative URL of the share image. */
	image?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	/** The EmDash entry this page renders: turns on the SEO panel overlay and hreflang. */
	content?: { collection: string; id: string; slug?: string | null };
	/** The text shown is English although the address is in another language: say so, and point the canonical at English. */
	isFallback?: boolean;
	/** For a page with no entry (the blog index): the languages it really exists in. */
	languages?: readonly Locale[];
	noindex?: boolean;
	/** schema.org structured data for this page, written into the head as JSON-LD. */
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description,
	image,
	type = "website",
	publishedTime,
	modifiedTime,
	content,
	isFallback = false,
	languages,
	noindex = false,
	jsonLd,
	shell,
} = Astro.props;

const locale = localeOf(Astro);
const path = neutralPath(Astro.url.pathname);

const { settings, primary, footer } = shell;
const { siteTitle, siteTagline } = identity(settings, Astro.site ?? Astro.url);
const logo = settings.logo?.url ? settings.logo : null;

const fullTitle = title ? `${title} — ${siteTitle}` : siteTagline ? `${siteTitle} — ${siteTagline}` : siteTitle;
const metaDescription = description || siteTagline || null;

// Canonical and share URLs come from `site` in astro.config.mjs, never from the host that
// happened to answer. A page showing English under /th/ or /ja/ is a copy of the English page.
// A page that is an error — the 404, or the 503 shown when the app does not answer — is not the
// page at its address, so it names none.
const canonical =
	(Astro.response.status ?? 200) >= 400 ? null : absoluteUrl(Astro, localePath(path, isFallback ? DEFAULT_LOCALE : locale));
const shareImage = image ? absoluteUrl(Astro, image) : (settings.seo?.defaultOgImage?.url ?? null);

// Menu items are stored without a language prefix; the layout adds it. A stored URL is never
// trusted as it is.
const href = (url: string) => sanitizeHref(url.startsWith("/") ? localePath(url, locale) : url);
const menuItems = (menu: typeof primary) => menu?.items ?? [];

// hreflang for a page with no entry behind it. Entry pages get theirs from EmDashHead.
const alternates =
	content || noindex || !languages
		? []
		: [
				...languages.map((l) => ({ hreflang: l, path: localePath(path, l) })),
				{ hreflang: "x-default", path: localePath(path, DEFAULT_LOCALE) },
			];

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: metaDescription,
	canonical,
	image: shareImage,
	content,
	seo: { ogImage: shareImage, robots: noindex ? "noindex, nofollow" : null },
	articleMeta: { publishedTime, modifiedTime },
	siteName: siteTitle,
	siteUrl: absoluteUrl(Astro, "/").replace(/\/$/, ""),
});

// Which page sent a visitor to the app: "home", "organisers", "blog", …
const from = path === "/" ? "home" : path.split("/")[1];
const isLoggedIn = Boolean(Astro.locals.user);
---

<!doctype html>
<html lang={locale} dir={directionOf(locale)}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-body" preload />
		{locale === "th" && <Font cssVariable="--font-thai" preload />}
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={absoluteUrl(Astro, a.path)} />)}
		{
			// "<" is escaped so that no name from outside can close the script element.
			jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
		}
		<link
			rel="alternate"
			type="application/rss+xml"
			title={siteTitle}
			href={absoluteUrl(Astro, localePath("/rss.xml", locale))}
		/>
		<script is:inline>
			// An explicit theme choice is applied before paint. With no cookie the OS decides.
			(function () {
				var row = document.cookie.split("; ").find(function (item) {
					return item.startsWith("theme=");
				});
				var theme = row ? row.slice(6) : null;
				if (theme === "dark" || theme === "light") document.documentElement.classList.add(theme);
			})();
		</script>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link" href="#main">{t(locale, "skipToContent")}</a>
		<header class="site-header">
			<div class="header-inner">
				<a href={localePath("/", locale)} class="site-title">
					{logo ? <img src={logo.url} alt={logo.alt || siteTitle} class="site-logo" /> : siteTitle}
				</a>
				<nav class="primary-nav" aria-label={t(locale, "primaryNav")}>
					{
						menuItems(primary).map((item) => (
							<a
								href={href(item.url)}
								target={item.target}
								rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
								aria-current={href(item.url) === localePath(path, locale) ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				<div class="header-actions">
					{isLoggedIn && <a href="/_emdash/admin" class="admin-link">Admin</a>}
					<a class="btn btn-primary btn-small" href={appHref({ page: "home" }, `${from}-header`)}>
						{t(locale, "openApp")}
					</a>
				</div>
			</div>
		</header>

		<main id="main">
			{
				isFallback && (
					<p class="notice" lang={DEFAULT_LOCALE} dir="ltr">
						{t(locale, "notTranslated")}
					</p>
				)
			}
			<div lang={isFallback ? DEFAULT_LOCALE : undefined} dir={isFallback ? "ltr" : undefined}>
				<slot />
			</div>
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<a href={localePath("/", locale)} class="footer-title">{siteTitle}</a>
					{siteTagline && <p class="footer-tagline">{siteTagline}</p>}
				</div>
				<nav class="footer-nav" aria-label={t(locale, "footerNav")}>
					<ul>
						{
							menuItems(footer).map((item) => (
								<li>
									<a href={href(item.url)}>{item.label}</a>
								</li>
							))
						}
						<li><a href={helpHref()}>{t(locale, "help")}</a></li>
						<li><a href={localePath("/rss.xml", locale)}>{t(locale, "rss")}</a></li>
					</ul>
				</nav>
				<div class="footer-tools">
					<LanguageSwitcher content={content} />
					<div class="theme-switch" role="group" aria-label={t(locale, "theme")}>
						<button type="button" data-theme="light">{t(locale, "themeLight")}</button>
						<button type="button" data-theme="dark">{t(locale, "themeDark")}</button>
						<button type="button" data-theme="system">{t(locale, "themeSystem")}</button>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// The footer's theme buttons: a cookie, so the server-rendered page and the next visit agree.
			const buttons = document.querySelectorAll<HTMLButtonElement>(".theme-switch button");
			const root = document.documentElement;
			const stored = () =>
				document.cookie
					.split("; ")
					.find((item) => item.startsWith("theme="))
					?.slice(6) || "system";
			const mark = (theme: string) =>
				buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.theme === theme)));
			function setTheme(theme: string) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				root.classList.remove("light", "dark");
				if (theme === "system") {
					document.cookie = `theme=; path=/; max-age=0; SameSite=Lax${secure}`;
				} else {
					document.cookie = `theme=${theme}; path=/; max-age=31536000; SameSite=Lax${secure}`;
					root.classList.add(theme);
				}
				mark(theme);
			}
			mark(stored());
			buttons.forEach((b) => b.addEventListener("click", () => setTheme(b.dataset.theme || "system")));
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		left: -9999px;
	}

	.skip-link:focus {
		left: var(--spacing-4);
		top: var(--spacing-4);
		z-index: 200;
		padding: var(--spacing-2) var(--spacing-4);
		background: var(--color-bg);
		border: 2px solid var(--color-brand);
		border-radius: var(--radius);
	}

	.site-header {
		border-bottom: 1px solid var(--color-border-subtle);
		background: var(--color-bg);
	}

	.header-inner {
		display: flex;
		align-items: center;
		gap: var(--spacing-6);
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-3) var(--spacing-6);
		min-height: var(--nav-height);
	}

	.site-title {
		font-size: var(--font-size-lg);
		font-weight: 700;
		color: var(--color-text);
		letter-spacing: var(--tracking-snug);
		white-space: nowrap;
	}

	.site-logo {
		height: 36px;
		width: auto;
	}

	.primary-nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-1) var(--spacing-5);
		font-size: var(--font-size-sm);
		margin-inline-start: auto;
	}

	.primary-nav a {
		color: var(--color-text);
		padding: var(--spacing-1) 0;
	}

	.primary-nav a:hover,
	.primary-nav a[aria-current="page"] {
		color: var(--color-brand);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
	}

	.admin-link {
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
	}

	main {
		min-height: 60vh;
	}

	.notice {
		max-width: var(--wide-width);
		margin: var(--spacing-4) auto 0;
		padding: var(--spacing-3) var(--spacing-6);
		font-size: var(--font-size-sm);
		color: var(--color-text-secondary);
		background: var(--color-surface);
		border-inline-start: 3px solid var(--color-brand);
	}

	.site-footer {
		margin-top: var(--spacing-16);
		background: var(--color-bg-subtle);
		border-top: 1px solid var(--color-border-subtle);
	}

	.footer-inner {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: var(--spacing-8);
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
		font-size: var(--font-size-sm);
	}

	.footer-title {
		font-size: var(--font-size-lg);
		font-weight: 700;
		color: var(--color-text);
	}

	.footer-tagline {
		margin-top: var(--spacing-2);
		color: var(--color-text-secondary);
		max-width: 32ch;
	}

	.site-footer ul {
		list-style: none;
		display: grid;
		gap: var(--spacing-2);
	}

	.site-footer nav a {
		color: var(--color-text-secondary);
	}

	.site-footer nav a:hover {
		color: var(--color-text);
	}

	.footer-tools {
		display: grid;
		gap: var(--spacing-4);
		align-content: start;
	}

	.theme-switch {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-1);
	}

	.theme-switch button {
		padding: var(--spacing-1) var(--spacing-2);
		font: inherit;
		font-size: var(--font-size-xs);
		color: var(--color-text-secondary);
		background: transparent;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		cursor: pointer;
	}

	.theme-switch button[aria-pressed="true"] {
		color: var(--color-text);
		background: var(--color-bg);
		border-color: var(--color-text-secondary);
	}

	@media (max-width: 760px) {
		.header-inner {
			flex-wrap: wrap;
			gap: var(--spacing-2) var(--spacing-4);
			padding: var(--spacing-3) var(--spacing-4);
		}

		.primary-nav {
			order: 3;
			width: 100%;
			margin-inline-start: 0;
		}

		.header-actions {
			margin-inline-start: auto;
		}

		.footer-inner {
			grid-template-columns: 1fr;
			padding: var(--spacing-8) var(--spacing-4);
		}
	}
</style>
