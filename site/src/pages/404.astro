---
// Every address with nothing behind it, in whichever language its address was in. Never cached, never indexed.
import Base from "../layouts/Base.astro";
import { t } from "../i18n/ui";
import { loadShell, localeOf, localePath } from "../lib/site";

const locale = localeOf(Astro);
Astro.response.status = 404;
const shell = await loadShell(Astro, { cacheable: false });
---

<Base title={t(locale, "notFoundTitle")} noindex shell={shell}>
	<div class="narrow page-head">
		<h1>{t(locale, "notFoundTitle")}</h1>
		<p class="lead">{t(locale, "notFoundBody")}</p>
		<div class="cta-row">
			<a class="btn" href={localePath("/", locale)}>{t(locale, "goHome")}</a>
		</div>
	</div>
</Base>
