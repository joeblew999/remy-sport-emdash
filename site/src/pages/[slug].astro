---
// "/<slug>" — an editor-written page: organisers, coaches, parents, about, privacy, terms, and
// any page an editor adds later. A slug with no published page is a 404.
import Base from "../layouts/Base.astro";
import { HOME_SLUG, loadEntry, loadShell, localeOf, localePath, slugParam } from "../lib/site";
import PageView from "../views/PageView.astro";

const slug = slugParam(Astro);
if (!slug) return Astro.rewrite("/404");
// The home entry is rendered at "/", and only there.
if (slug === HOME_SLUG) return Astro.redirect(localePath("/", localeOf(Astro)), 301);

const found = await loadEntry(Astro, "pages", slug);
if (!found) return Astro.rewrite("/404");
const { entry: page, isFallback } = found;
const shell = await loadShell(Astro);
---

<Base
	shell={shell}
	title={page.data.title}
	description={page.data.summary}
	content={{ collection: "pages", id: page.data.id, slug: page.id }}
	isFallback={isFallback}
	noindex={Boolean(page.data.placeholder)}
>
	<PageView page={page} />
</Base>
