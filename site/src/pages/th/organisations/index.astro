---
// The Thai address of the same route under ../ — the same code; the language comes from the URL.
// "/organisations" — every organisation the app lists. Read from the app's public API (lib/app.ts).
import AppUnavailable from "../../../components/AppUnavailable.astro";
import { APP_DATA_IS_REAL } from "../../../lib/app";
import Base from "../../../layouts/Base.astro";
import { LOCALES, t } from "../../../i18n/ui";
import { loadOrgsIndex, markUnavailable } from "../../../lib/entities";
import { loadShell, localeOf } from "../../../lib/site";
import OrgsIndexView from "../../../views/OrgsIndexView.astro";

const locale = localeOf(Astro);
const orgs = await loadOrgsIndex();
if (!orgs) markUnavailable(Astro);
const shell = await loadShell(Astro, { cacheable: Boolean(orgs) });
---

<Base
	shell={shell}
	title={t(locale, "orgsTitle")}
	description={t(locale, "orgsDescription")}
	languages={LOCALES}
	noindex={!orgs || !APP_DATA_IS_REAL}
>
	{orgs ? <OrgsIndexView orgs={orgs} /> : <AppUnavailable />}
</Base>
