---
// The Thai address of the same route under ../ — the same code; the language comes from the URL.
// "/events" — every event the app lists. Read from the app's public API (lib/app.ts).
import AppUnavailable from "../../../components/AppUnavailable.astro";
import { APP_DATA_IS_REAL } from "../../../lib/app";
import Base from "../../../layouts/Base.astro";
import { LOCALES, t } from "../../../i18n/ui";
import { loadEventsIndex, markUnavailable } from "../../../lib/entities";
import { loadShell, localeOf } from "../../../lib/site";
import EventsIndexView from "../../../views/EventsIndexView.astro";

const locale = localeOf(Astro);
const data = await loadEventsIndex();
if (!data) markUnavailable(Astro);
const shell = await loadShell(Astro, { cacheable: Boolean(data) });
---

<Base
	shell={shell}
	title={t(locale, "eventsTitle")}
	description={t(locale, "eventsDescription")}
	languages={LOCALES}
	noindex={!data || !APP_DATA_IS_REAL}
>
	{data ? <EventsIndexView upcoming={data.upcoming} past={data.past} /> : <AppUnavailable />}
</Base>
