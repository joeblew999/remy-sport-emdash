---
// "/th/" — the same route as ../index.astro. The language comes from the URL (Astro.currentLocale).
import Base from "../../layouts/Base.astro";
import { loadHome, loadShell } from "../../lib/site";
import HomeView from "../../views/HomeView.astro";

const data = await loadHome(Astro);
if (!data) return Astro.rewrite("/404");
const shell = await loadShell(Astro);
---

<Base shell={shell} description={data.home.entry.data.summary} isFallback={data.home.isFallback} languages={data.languages}>
	<HomeView home={data.home.entry} audiences={data.audiences} posts={data.posts} />
</Base>
