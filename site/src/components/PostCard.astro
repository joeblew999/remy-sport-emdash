---
import type { ContentEntry, InferCollectionData } from "emdash";
import { formatDate, t } from "../i18n/ui";
import { getReadingTime } from "../lib/reading-time";
import { localeOf, localePath } from "../lib/site";

interface Props {
	post: ContentEntry<InferCollectionData<"posts">>;
	/** The language the card's link stays in — the request's, even when the post is the English fallback. */
	heading?: "h2" | "h3";
}

const { post, heading: Heading = "h3" } = Astro.props;
const locale = localeOf(Astro);
const date = formatDate(locale, post.data.publishedAt);
---

<a class="card" href={localePath(`/blog/${post.id}`, locale)}>
	<p class="meta">
		{date && <time datetime={post.data.publishedAt?.toISOString()}>{date}</time>}
		{date && " · "}
		{getReadingTime(post.data.content)}{" "}
		{t(locale, "minRead")}
	</p>
	<Heading {...post.edit.title}>{post.data.title}</Heading>
	{post.data.excerpt && <p {...post.edit.excerpt}>{post.data.excerpt}</p>}
</a>
